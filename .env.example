# --- Required -------------------------------------------------------------
# Full RPC URL. For Helius put the key in the query string; it never appears in logs or errors.
LP_RPC_URL=https://mainnet.helius-rpc.com/?api-key=REPLACE_ME

# --- HTTP -----------------------------------------------------------------
LP_HTTP_ADDR=:8080
LP_LOG_LEVEL=info                 # debug | info | warn | error

# --- RPC ------------------------------------------------------------------
LP_RPC_TIMEOUT=60s                # per attempt
LP_RPC_MAX_RETRIES=3              # retried on 429 / 5xx / node-unhealthy (0 = no retry)
LP_RPC_MAX_CONCURRENCY=8          # in-flight requests across the process
LP_RPC_USE_GPA_V2=false           # Helius getProgramAccountsV2 (paginated); true on Helius for very large pools
LP_RPC_USE_DAS=true               # Helius getAssetBatch for NFT owners; auto-disabled if the endpoint lacks it

# --- Holder scans ---------------------------------------------------------
LP_MAX_POSITIONS=50000            # refuse on-demand scans above this (0 = no limit)
LP_NFT_FALLBACK_CONCURRENCY=8     # getTokenLargestAccounts fan-out when DAS is unavailable

# --- Cache (in-process) ---------------------------------------------------
LP_CACHE_TTL=60s
LP_NEGATIVE_CACHE_TTL=5m          # remembers "not found / unsupported / too large"
LP_CACHE_MAX_ENTRIES=256
LP_CACHE_MAX_HOLDERS=1000000      # total holder rows across cached snapshots (~400 B each)
LP_COMPUTE_TIMEOUT=2m             # budget of one snapshot; HTTP write timeout is this + 10s

# --- Protection -----------------------------------------------------------
LP_MAX_CONCURRENT_COMPUTES=4      # cold-cache computations at once; more get HTTP 503 "busy"

# --- Optional: USD prices (Birdeye multi_price) ---------------------------
# Public API: https://public-api.birdeye.so + /defi/multi_price (needs API key)
# Internal birdeye_backend: http://<host>:3000 + /public/multi_price
LP_PRICE_BASE_URL=
LP_PRICE_PATH=/defi/multi_price
LP_PRICE_API_KEY=

# --- Optional: LP holders from token-holder's ClickHouse index ------------
# Replicas per shard separated by "|", shards by ",", in the SAME order as token-holder's
# clickhouse_wallet_info.shards (routing is cityHash64(lp_mint) % shard_count).
LP_CLICKHOUSE_SHARDS=
LP_CLICKHOUSE_USER=default
LP_CLICKHOUSE_PASSWORD=
LP_CLICKHOUSE_TABLE=wallet_info.token_holder_local
LP_CLICKHOUSE_MAX_ROWS=100000
